rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profile and top-level user doc
    match /users/{userId} {
      allow get, list, create, update, delete: if isOwner(userId) && isValidId(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get, list, delete: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(taskId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 300;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(taskId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 300;
      }

      // Classes timetable subcollection
      match /classes/{classId} {
        allow get, list, delete: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(classId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.subject is string
                      && request.resource.data.subject.size() > 0
                      && request.resource.data.subject.size() <= 200;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(classId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.subject is string
                      && request.resource.data.subject.size() > 0
                      && request.resource.data.subject.size() <= 200;
      }

      // Assignments subcollection
      match /assignments/{assignmentId} {
        allow get, list, delete: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(assignmentId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 300;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(assignmentId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.title is string
                      && request.resource.data.title.size() > 0
                      && request.resource.data.title.size() <= 300;
      }

      // Daily resets subcollection
      match /dailyResets/{dateId} {
        allow get, list, delete: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(dateId)
                      && request.resource.data.userId == request.auth.uid;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(dateId)
                      && request.resource.data.userId == resource.data.userId;
      }
    }
  }
}
